{
  "name": "explain-it",
  "version": "0.2.0",
  "private": true,
  "description": "Agent skill that explains how software works in ASD-STE100, with a system overview SVG and an interactive walkthrough.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tests/run-tests.mjs",
    "lint:ste100": "node skills/explain-it/scripts/ste100-lint.mjs",
    "demo": "node skills/explain-it/scripts/render-schematic.mjs --fixture tests/fixtures/sample-flow.json --out dist/demo-schematic.html --tier high",
    "demo:docs-site": "node skills/explain-it/scripts/render-schematic.mjs --fixture tests/fixtures/docs-site-flow.json --out dist/docs-site-schematic.html --tier med",
    "trace": "node skills/explain-it/scripts/trace-flow.mjs"
  }
}
